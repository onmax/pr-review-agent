# Webhook secret (required - same value in GitHub App/webhook settings)
# Generate with: openssl rand -hex 20
NUXT_GITHUB_WEBHOOK_SECRET=your-webhook-secret

# --- GitHub App Auth (primary - recommended) ---
# Create at: https://github.com/settings/apps/new
NUXT_GITHUB_APP_ID=123456
NUXT_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- PAT Fallback (for external repos or local dev) ---
# Fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required permissions: Contents (read), Issues (read/write), Pull requests (read)
# NUXT_GITHUB_TOKEN=github_pat_xxx

# Access control (comma-separated, empty = allow all)
NUXT_ALLOWED_USERS=onmax
NUXT_ALLOWED_REPOS=onmax/some-repo,onmax/another-repo

# Optional: Model configuration
# NUXT_SECURITY_MODEL=opus
# NUXT_ANALYSIS_MODEL=sonnet
# NUXT_UTILITY_MODEL=haiku
