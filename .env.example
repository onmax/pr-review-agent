# Required
NUXT_GITHUB_WEBHOOK_SECRET=your-webhook-secret
NUXT_GITHUB_TOKEN=ghp_your_personal_access_token

# Access control (comma-separated, empty = allow all)
NUXT_ALLOWED_USERS=onmax
NUXT_ALLOWED_REPOS=onmax/some-repo,onmax/another-repo

# Optional: Model configuration
# NUXT_SECURITY_MODEL=opus
# NUXT_ANALYSIS_MODEL=sonnet
# NUXT_UTILITY_MODEL=haiku
